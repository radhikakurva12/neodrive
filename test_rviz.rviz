      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
        Camera:
          Value: true
        Front_Left:
          Value: true
        Front_Right:
          Value: true
        LIDAR:
          Value: true
        Rear_Left:
          Value: true
        Rear_Right:
          Value: true
        U_1:
          Value: true
        U_2:
          Value: true
        U_3:
          Value: true
        U_4:
          Value: true
        base_footprint:
          Value: true
        base_link:
          Value: true
        map:
          Value: true
        odom:
          Value: true
